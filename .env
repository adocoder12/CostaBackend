# Server
PORT=8080
GIN_MODE=debug                         # release in production

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password
DB_NAME=costaBackend
DB_SSLMODE=disable

# Supabase JWT
SUPABASE_JWT_SECRET=your-jwt-secret    # from Supabase dashboard → Settings → API

# AWS / LocalStack
AWS_ENDPOINT=http://localstack:4566
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=costa-pms-uploads
SQS_QUEUE_URL=http://localstack:4566/000000000000/ses-hospedajes-queue

# CORS
ALLOWED_ORIGIN=http://localhost:3000