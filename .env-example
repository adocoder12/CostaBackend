# Server
PORT=8080
GIN_MODE=debug                         # release in production

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password
DB_NAME=costaBackend
DB_SSLMODE=disable

# Supabase JWT
SUPABASE_JWT_SECRET=your-jwt-secret    # from Supabase dashboard → Settings → API

# AWS / LocalStack
AWS_ENDPOINT=http://localstack:4566
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=costa-pms-uploads
AWS_S3_ENDPOINT=http://localhost:9000
AWS_EVENT_QUEUE_NAME=costa-pms-events
# CORS
ALLOWED_ORIGIN=http://localhost:

UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=10485760 # 100MB
UPLOAD_PROVIDER=local